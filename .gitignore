# User-generated config (contains local paths — never commit)
dune-server.config

# Logs
*.log
.logs/

# Local SSH keys — never commit
sshKey
sshKey.pub
*.pem
*.key

# Local environment overrides
.env
.env.*
!.env.example

# Windows
Thumbs.db
desktop.ini

# macOS
.DS_Store

# Editor / IDE
.vscode/
.idea/
*.swp
*~

# Session / scratch
scratch/
tmp/

# Desktop app build artifacts (built locally before each release)
app/build/output/
app/installer/output/

# Linux .deb build output (built locally / in CI)
packaging/linux/output/

# Pre-redaction screenshot originals — contain real PII, never commit
docs/img/_originals/

# OneDrive cloud-sync leftovers — corrupt dehydrated placeholders that also
# break ripgrep (os error 383). Never commit.
*.todelete.gone~*
*~RF*.TMP

testResults.xml

# ---- BEGIN machine-wide rules (tools/gitignore-master.txt) ----
# ==========================================================================
# Master .gitignore — generated by tools/gitignore.py, applied machine-wide.
#
# Purpose: these repos are pushed to a self-hosted forgejo (git.unityailab.com)
# as a BACKUP OF SOURCE, not of build output. A clone is expected to need a
# build and a dependency install before it runs. That is the deliberate
# trade: ~1 TB on disk becomes a few GB on the server.
#
# Ordered by how much disk each class actually occupies here, measured
# 2026-09-04 across 291 candidate projects.
#
# Edit tools/gitignore.py, not the copies this generates.
# ==========================================================================

# --------------------------------------------------------------------------
# CREDENTIALS AND SECRETS — the highest-stakes section.
# An ignore rule does NOT remove an already-tracked file. Run
# `python3 tools/secretscan.py` before any push.
# --------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.template
!.env.sample
*.pem
*.key
!**/public*.key
*.p12
*.pfx
*.jks
*.keystore
*.ppk
id_rsa
id_dsa
id_ecdsa
id_ed25519
*_rsa
*_ed25519
.netrc
.pgpass
.htpasswd
credentials
credentials.json
client_secret*.json
service-account*.json
*serviceaccount*.json
secrets.json
secrets.yaml
secrets.yml
*.secret
*.secrets
token.txt
tokens.txt
*.token
auth.json
.aws/credentials
.ssh/
gha-creds-*.json
# Tool-specific credential stores seen on this machine
.claude/settings.local.json
.jcode/auth.json
keys.json
appsettings.Development.json

