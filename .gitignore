*.ggml
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
!**/rustc-dev/**/*.bin
*.onnx
*.tflite
*.h5
*.hdf5
*.pkl
*.pickle
*.npz
*.npy
*.arrow
*.msgpack
models/
!**/src/**/models/
!**/app/**/models/
checkpoints/
*.lora
adapter_model.*

